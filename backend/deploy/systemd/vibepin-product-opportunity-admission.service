# VibePin daily Product Opportunity admission. DISABLED AND SAFE BY DEFAULT.
[Unit]
Description=VibePin Product Opportunity bounded admission (preflight-gated)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=oneshot
WorkingDirectory=/opt/vibepin/backend
EnvironmentFile=-/opt/vibepin/backend/.env
Environment=VIBEPIN_PRODUCT_ADMISSION_RUN_MODE=preflight
Environment=VIBEPIN_LOCK_DIR=/opt/vibepin/locks
Environment=VIBEPIN_PRODUCT_ADMISSION_TIMEOUT_SECONDS=2400
Environment=VIBEPIN_PRODUCT_ADMISSION_SOURCE_REPORT=/opt/vibepin/backend/logs/product_supply_expand_shop_the_look_latest.json
ExecStart=/opt/vibepin/backend/scripts/cloud_run_product_opportunity_admission.sh
TimeoutStartSec=2700
TimeoutStopSec=60
KillMode=control-group
Restart=no
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vibepin-product-opportunity-admission

[Install]
WantedBy=multi-user.target
